# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL - Coolify or local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amigodenatal

# Security
PIN_PEPPER=change-me-to-a-long-random-secret-string
CRON_SECRET=change-me-cron-secret
FOUNDER_ADMIN_KEY=change-me-founder-secret-key

# AI (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Payments (AbacatePay PIX or "mock" for local testing)
PAYMENT_PROVIDER=mock
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=

# Affiliates (Amazon Associates & Mercado Livre)
NEXT_PUBLIC_AMAZON_TAG=amigodenatal-20
NEXT_PUBLIC_MELI_TAG=amigodenatal

# Optional Free Web Push (VAPID - generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@gbabler.com

# Support contact displayed in footer & recovery fallback
NEXT_PUBLIC_SUPPORT_EMAIL=contato@gbabler.com
